# Published Casa Maíz Payload CMS base URL (default). Point this at a tunnel,
# staging, or self-hosted instance to change where the app reads content.
API_BASE_URL=https://payload-cms-poc-seven.vercel.app

# Installed application version reported as appVersion context (semantic x.y.z).
# Values such as `1` or `v1.0` are invalid.
APP_VERSION=1.0.0

# Delivery context appended to every content request.
MARKET=MX
AUDIENCE=guest

# Mobile content contract version this build supports.
CONTRACT_VERSION=1.1